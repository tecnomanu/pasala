<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="send_clipboard"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_clip"
        android:shortcutShortLabel="@string/shortcut_clip_short"
        android:shortcutLongLabel="@string/shortcut_clip_long">
        <intent
            android:action="com.tecnomanu.pasala.action.SEND_CLIPBOARD"
            android:targetPackage="com.tecnomanu.pasala"
            android:targetClass="com.tecnomanu.pasala.ui.send.TextActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="send_files"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_files"
        android:shortcutShortLabel="@string/shortcut_files_short"
        android:shortcutLongLabel="@string/shortcut_files_long">
        <intent
            android:action="com.tecnomanu.pasala.action.PICK_FILES"
            android:targetPackage="com.tecnomanu.pasala"
            android:targetClass="com.tecnomanu.pasala.ui.send.ShareActivity" />
    </shortcut>
</shortcuts>
